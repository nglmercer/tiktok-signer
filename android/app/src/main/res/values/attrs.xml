<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="CollapsibleCard">
        <attr name="cardTitle" format="string" />
        <attr name="startExpanded" format="boolean" />
    </declare-styleable>

    <declare-styleable name="EmptyStateView">
        <attr name="emptyMessage" format="string" />
        <attr name="emptyIcon" format="reference" />
    </declare-styleable>

    <declare-styleable name="SectionHeaderView">
        <attr name="sectionTitle" format="string" />
        <attr name="sectionCount" format="string" />
    </declare-styleable>

    <declare-styleable name="SettingRowView">
        <attr name="rowLabel" format="string" />
    </declare-styleable>

    <declare-styleable name="MinimalDivider">
        <attr name="dividerInsetStart" format="dimension" />
        <attr name="dividerInsetEnd" format="dimension" />
    </declare-styleable>
</resources>
