<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material3 day/night, no system action bar: the layout draws its own
         MaterialToolbar. Dynamic color re-seeds this on Android 12+. -->
    <style name="Theme.TtlSigner" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- Minimalist card: flat outline, no elevation, single shared radius. -->
    <style name="Widget.TikTools.MinimalCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/stroke_minimal</item>
        <item name="cardCornerRadius">@dimen/radius_minimal</item>
    </style>

    <!-- Small section label: sentence case, letterspaced, muted. -->
    <style name="TextAppearance.TikTools.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Muted secondary line for counts, hints, and about text. -->
    <style name="TextAppearance.TikTools.Muted" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Minimalist tab bar: thin indicator, compact text. -->
    <style name="Widget.TikTools.MinimalTabs" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
    </style>
</resources>
