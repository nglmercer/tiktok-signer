<?xml version="1.0" encoding="utf-8"?>
<!-- Setup tab: connection, live feed, TTS, signer/session, log. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TikTools.MinimalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <com.example.ttlsigner.ui.StatusPillView
                    android:id="@+id/statusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/username_hint"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/usernameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/connectButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/connect" />

                    <Button
                        android:id="@+id/disconnectButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:enabled="false"
                        android:maxLines="1"
                        android:text="@string/disconnect" />

                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/setupProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:indeterminate="true"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.example.ttlsigner.ui.CollapsibleCard
            android:id="@+id/feedCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardTitle="@string/feed_label">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/feedButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/feed" />

                    <Button
                        android:id="@+id/randomButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/random" />

                </LinearLayout>

                <TextView
                    android:id="@+id/feedError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.TikTools.Muted"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/feedList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:clipToPadding="false"
                    android:minHeight="48dp" />

            </LinearLayout>

        </com.example.ttlsigner.ui.CollapsibleCard>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TikTools.MinimalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <com.example.ttlsigner.ui.SectionHeaderView
                    android:id="@+id/ttsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/tts_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/tts_note"
                    android:textAppearance="@style/TextAppearance.TikTools.Muted" />

                <RadioGroup
                    android:id="@+id/ttsEngineGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/ttsEngineOff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tts_engine_off" />

                    <RadioButton
                        android:id="@+id/ttsEngineDevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tts_engine_device" />

                    <RadioButton
                        android:id="@+id/ttsEngineSuper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tts_engine_super" />

                </RadioGroup>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/ttsJoinsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tts_joins" />

                <TextView
                    android:id="@+id/supertonicStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.TikTools.Muted" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/supertonicProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/downloadSupertonicButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/supertonic_download" />

                    <Button
                        android:id="@+id/testSpeechButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/test_speech" />

                </LinearLayout>

                <TextView
                    android:id="@+id/ttsControlsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/tts_controls_hint"
                    android:textAppearance="@style/TextAppearance.TikTools.Muted"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ttsControlsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/repeatSpeechButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:enabled="false"
                        android:maxLines="1"
                        android:text="@string/repeat_speech" />

                    <Button
                        android:id="@+id/skipSpeechButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/skip_speech" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TikTools.MinimalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <com.example.ttlsigner.ui.SectionHeaderView
                    android:id="@+id/signerHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/settings_signer" />

                <com.example.ttlsigner.ui.SettingRowView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    app:rowLabel="@string/settings_native_version">

                    <TextView
                        android:id="@+id/nativeVersionValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                </com.example.ttlsigner.ui.SettingRowView>

                <com.example.ttlsigner.ui.MinimalDivider
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_sm" />

                <com.example.ttlsigner.ui.SettingRowView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowLabel="@string/settings_bundle_cache">

                    <TextView
                        android:id="@+id/bundleCacheValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_bundle_none"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                </com.example.ttlsigner.ui.SettingRowView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/redownloadButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/redownload" />

                    <Button
                        android:id="@+id/clearCacheButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/clear_cache" />

                </LinearLayout>

                <com.example.ttlsigner.ui.MinimalDivider
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_sm" />

                <com.example.ttlsigner.ui.SettingRowView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowLabel="@string/settings_cookies">

                    <TextView
                        android:id="@+id/guestValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_no_cookies"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                </com.example.ttlsigner.ui.SettingRowView>

                <Button
                    android:id="@+id/resetSessionButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/reset_session" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TikTools.MinimalCard"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="@dimen/space_md">

            <com.example.ttlsigner.ui.LogConsoleView
                android:id="@+id/logConsole"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/aboutValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/settings_about_text"
            android:textAppearance="@style/TextAppearance.TikTools.Muted" />

    </LinearLayout>

</ScrollView>
