{
  "name": "ttl-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TikTok LIVE events in Node, with no sign server, no native module and no browser.",
  "license": "MIT",
  "main": "./src/index.mjs",
  "types": "./index.d.ts",
