    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": ["src", "vendor", "index.d.ts", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test test/",
    "sync-bootstrap": "node ../../scripts/headless/tools/build-bootstrap.mjs vendor/bootstrap.js",
    "listen": "node examples/listen.mjs"
  }
}
